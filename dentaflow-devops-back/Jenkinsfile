pipeline {
    agent any
 
    stages {
 
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
 
        stage('Restore') {
            steps {
                sh 'dotnet restore'
            }
        }
 
        stage('Build') {
            steps {
                sh 'dotnet build -c Release'
            }
        }
 
        stage('Test') {
            steps {
                sh 'dotnet test -c Release'
            }
        }
 
        stage('Publish') {
            steps {
                sh '''
                rm -rf workspace/publish
                dotnet publish -c Release -o workspace/publish
                '''
            }
        }

 
    post {
        success {
            echo 'Backend déployé avec succès'
        }
        failure {
            echo 'Erreur dans la pipeline backend'
        }
    }
}